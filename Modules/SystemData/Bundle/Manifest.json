{
  "id": "com.macspace.system-data",
  "name": "System Data",
  "summary": "See what fills System Data and free what is safe to remove.",
  "version": "0.1.0",
  "sdkVersion": 7,
  "symbol": "externaldrive.badge.checkmark",
  "minimumMacOS": "26.0",
  "order": 10,
  "permissions": [
    "fullDiskAccess",
    "privilegedHelper"
  ],
  "options": [
    {
      "id": "cacheCleanup",
      "title": "Free caches",
      "kind": {
        "toggle": {
          "defaultValue": true
        }
      }
    },
    {
      "id": "cacheCleaner",
      "title": "Cache cleaner",
      "under": "cacheCleanup",
      "kind": {
        "choice": {
          "options": [
            {
              "id": "macspace",
              "title": "MacSpace"
            },
            {
              "id": "cleanmymac",
              "title": "CleanMyMac",
              "apps": [
                "com.macpaw.CleanMyMac5",
                "com.macpaw.CleanMyMac4",
                "com.macpaw.CleanMyMac-setapp"
              ]
            },
            {
              "id": "mole",
              "title": "Mole",
              "apps": [
                "com.tw93.MoleApp"
              ]
            },
            {
              "id": "onyx",
              "title": "OnyX",
              "apps": [
                "com.titanium.OnyX"
              ]
            },
            {
              "id": "pearcleaner",
              "title": "Pearcleaner",
              "apps": [
                "com.alienator88.Pearcleaner"
              ]
            },
            {
              "id": "purge",
              "title": "Purge",
              "apps": [
                "io.getpurge.app"
              ]
            },
            {
              "id": "sensei",
              "title": "Sensei",
              "apps": [
                "org.cindori.Sensei"
              ]
            }
          ],
          "defaultValue": "macspace"
        }
      }
    }
  ],
  "backgroundTasks": [],
  "tileSize": "wide",
  "tileTint": "blue",
  "autoClean": true
}
